+      numberOfPlayers: players.length,
+    );
+    _players = players;
+    _teams = teams;
+    _pendingFiesta = setup?.fiesta;
+    // Sans ce reset, `restartWithSamePlayers` relirait la Fiesta de la partie
+    // suspendue par-dessus celle de l'archive.
