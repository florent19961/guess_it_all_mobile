+        catalogId: def.id,
+        scope: ModifierScope.round,
+        target: ModifierTarget.team,
+        teamId: teamId,
+        charges: charges,
+        nature: def.nature,
+        round: round,
+        reserve: def.nature == ModifierNature.malus,
+      ));
+    }
+  }
+  return stock;
