+/// ([ModifierInstance.reserve]) : persistés, sans effet jusqu'à l'écran
+/// « Ce tour / Réserve » (lane 2).
+List<ModifierInstance> stockForRound(
+  FiestaRules rules, {
+  required int round,
+  required Iterable<String> teamIds,
