+/// Case d'une manche (1, 2, 3) : cochée, décochée, interdite (grisée) ou
+/// verrouillée (mime : manche 3 d'office).
+class _RoundBox extends StatelessWidget {
+  final int round;
+  final bool on;
+  final bool enabled;
+  final bool locked;
+  final VoidCallback? onTap;
+
+  const _RoundBox({
+    required this.round,
+    required this.on,
+    this.enabled = true,
+    this.locked = false,
+    this.onTap,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final active = enabled && !locked;
+    return Semantics(
+      button: active,
+      checked: on,
+      enabled: active,
+      label: locked ? 'Manche $round, verrouillée' : 'Manche $round',
+      child: GestureDetector(
+        onTap: active ? onTap : null,
+        child: Container(
+          margin: const EdgeInsets.only(left: 6),
+          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+          decoration: BoxDecoration(
+            color: on && enabled
+                ? AppColors.secondaryCyan
+                : AppColors.backgroundCard,
+            borderRadius: BorderRadius.circular(10),
+            border: Border.all(
+                color: enabled ? AppColors.gray600 : AppColors.gray700),
+          ),
+          child: Row(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              Text(
+                '$round',
+                style: AppTextStyles.label.copyWith(
+                  color: !enabled
+                      ? AppColors.gray600
+                      : on
+                          ? AppColors.backgroundMain
+                          : Colors.white,
+                ),
+              ),
+              if (locked) ...[
+                const SizedBox(width: 4),
+                const Icon(Icons.lock,
+                    size: 13, color: AppColors.backgroundMain),
+              ],
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Compteur compact −/+.
+class _Stepper extends StatelessWidget {
+  final int value;
+  final int min;
+  final int max;
+  final ValueChanged<int> onChanged;
+
+  const _Stepper({
+    required this.value,
+    required this.min,
+    required this.max,
+    required this.onChanged,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    Widget button(IconData icon, int next, bool enabled, String label) =>
+        IconButton(
+          tooltip: label,
+          onPressed: enabled ? () => onChanged(next) : null,
+          icon: Icon(icon, size: 18),
+          color: Colors.white,
+          disabledColor: AppColors.gray600,
+          style: IconButton.styleFrom(backgroundColor: AppColors.gray700),
+        );
+    return Row(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        button(Icons.remove, value - 1, value > min, 'Moins'),
+        SizedBox(
+          width: 28,
+          child: Text(
+            '$value',
+            style: AppTextStyles.label,
+            textAlign: TextAlign.center,
+          ),
+        ),
+        button(Icons.add, value + 1, value < max, 'Plus'),
+      ],
+    );
+  }
+}
+
+/// Choix exclusif entre quelques options. [selected] hors de [values] = rien
+/// de surligné (l'autre famille de modes est choisie).
+class _Choices<T> extends StatelessWidget {
+  final List<T> values;
+  final T selected;
+  final bool enabled;
+  final String Function(T) label;
+  final ValueChanged<T> onSelect;
+
+  const _Choices({
+    required this.values,
+    required this.selected,
+    required this.label,
+    required this.onSelect,
+    this.enabled = true,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return Row(
+      children: [
+        for (final value in values)
+          Expanded(
+            child: GestureDetector(
+              onTap: enabled ? () => onSelect(value) : null,
+              child: Container(
+                margin: const EdgeInsets.symmetric(horizontal: 2),
+                padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 8),
+                decoration: BoxDecoration(
+                  color: value == selected
+                      ? AppColors.secondaryCyan
+                      : AppColors.backgroundCard,
+                  borderRadius: BorderRadius.circular(12),
+                ),
+                child: Text(
+                  label(value),
+                  textAlign: TextAlign.center,
+                  style: AppTextStyles.bodySmall.copyWith(
+                    fontSize: 11,
+                    color: !enabled
+                        ? AppColors.gray600
+                        : value == selected
+                            ? AppColors.backgroundMain
+                            : Colors.white,
+                  ),
+                ),
+              ),
+            ),
+          ),
+      ],
+    );
+  }
+}
