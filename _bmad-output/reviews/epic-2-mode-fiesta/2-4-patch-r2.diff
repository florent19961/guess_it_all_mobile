@@ -0,0 +1,323 @@
+import 'package:flutter/material.dart';
+
+import '../../models/fiesta/fiesta_rules.dart';
+import '../../theme/app_theme.dart';
+import '../common/app_back_button.dart';
+import '../effects/shooting_stars.dart';
+
+/// Squelette commun des écrans de choix du mode (Mode de jeu, Fiesta, Auto,
+/// Récap) : titre, contenu défilant, bouton bas, et retour — bouton ET geste
+/// système (Android) — vers [onBack], pour ne pas quitter l'app par surprise.
+class FiestaSetupScaffold extends StatelessWidget {
+  final String title;
+  final String? subtitle;
+  final VoidCallback onBack;
+  final List<Widget> content;
+  final Widget bottom;
+
+  const FiestaSetupScaffold({
+    required this.title,
+    this.subtitle,
+    required this.onBack,
+    required this.content,
+    required this.bottom,
+    super.key,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return PopScope(
+      canPop: false,
+      onPopInvokedWithResult: (didPop, _) {
+        if (!didPop) onBack();
+      },
+      child: ShootingStars(
+        child: Stack(
+          children: [
+            SafeArea(
+              child: Padding(
+                padding: const EdgeInsets.all(24),
+                child: Column(
+                  children: [
+                    Expanded(
+                      child: SingleChildScrollView(
+                        child: Column(
+                          crossAxisAlignment: CrossAxisAlignment.stretch,
+                          children: [
+                            const SizedBox(height: 48),
+                            Text(
+                              title,
+                              textAlign: TextAlign.center,
+                              style: AppTextStyles.subtitle(fontSize: 40),
+                            ),
+                            if (subtitle != null) ...[
+                              const SizedBox(height: 4),
+                              Text(
+                                subtitle!,
+                                textAlign: TextAlign.center,
+                                style: AppTextStyles.bodySmall
+                                    .copyWith(color: AppColors.gray400),
+                              ),
+                            ],
+                            const SizedBox(height: 24),
+                            ...content,
+                          ],
+                        ),
+                      ),
+                    ),
+                    const SizedBox(height: 16),
+                    bottom,
+                  ],
+                ),
+              ),
+            ),
+            AppBackButton(onPressed: onBack),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+/// Carte sélectionnable (maquette `.pick`).
+class FiestaPickCard extends StatelessWidget {
+  final String icon;
+  final String title;
+  final String description;
+  final bool selected;
+  final VoidCallback onTap;
+
+  const FiestaPickCard({
+    required this.icon,
+    required this.title,
+    required this.description,
+    required this.selected,
+    required this.onTap,
+    super.key,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 12),
+      child: GestureDetector(
+        onTap: onTap,
+        child: Container(
+          padding: const EdgeInsets.all(14),
+          decoration: BoxDecoration(
+            color: AppColors.backgroundCard,
+            borderRadius: BorderRadius.circular(16),
+            border: Border.all(
+              color: selected ? AppColors.secondaryCyan : AppColors.gray600,
+              width: 2,
+            ),
+          ),
+          child: Row(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Container(
+                width: 44,
+                height: 44,
+                alignment: Alignment.center,
+                decoration: BoxDecoration(
+                  color: AppColors.secondaryCyan.withValues(alpha: 0.18),
+                  borderRadius: BorderRadius.circular(14),
+                ),
+                child: Text(
+                  icon,
+                  style: const TextStyle(
+                    fontFamily: 'Bangers',
+                    fontSize: 22,
+                    color: AppColors.secondaryCyan,
+                  ),
+                ),
+              ),
+              const SizedBox(width: 12),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(title, style: AppTextStyles.label),
+                    const SizedBox(height: 2),
+                    Text(
+                      description,
+                      style: AppTextStyles.bodySmall.copyWith(
+                        fontSize: 12,
+                        color: AppColors.gray400,
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Carte à titre en capitales (maquette `.card`), [trailing] à droite du titre.
+class FiestaCard extends StatelessWidget {
+  final String title;
+  final Widget? trailing;
+  final List<Widget> children;
+
+  const FiestaCard({
+    required this.title,
+    this.trailing,
+    this.children = const [],
+    super.key,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      margin: const EdgeInsets.only(bottom: 12),
+      padding: const EdgeInsets.all(14),
+      decoration: BoxDecoration(
+        color: AppColors.backgroundCard,
+        borderRadius: BorderRadius.circular(18),
+        border: Border.all(color: AppColors.gray700),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Row(
+            children: [
+              Expanded(
+                child: Text(
+                  title.toUpperCase(),
+                  style: AppTextStyles.label.copyWith(
+                    fontSize: 12,
+                    letterSpacing: 1.2,
+                    color: AppColors.gray400,
+                  ),
+                ),
+              ),
+              if (trailing != null) trailing!,
+            ],
+          ),
+          if (children.isNotEmpty) const SizedBox(height: 8),
+          ...children,
+        ],
+      ),
+    );
+  }
+}
+
+/// Ligne libellé + détail, avec un interrupteur si [onChanged] est donné,
+/// sinon « Oui / Non » en lecture seule (Récap).
+class FiestaLine extends StatelessWidget {
+  final String label;
+  final String? detail;
+  final bool? value;
+  final ValueChanged<bool>? onChanged;
+
+  const FiestaLine({
+    required this.label,
+    this.detail,
+    this.value,
+    this.onChanged,
+    super.key,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final v = value;
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 6),
+      child: Row(
+        children: [
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(label, style: AppTextStyles.bodySmall),
+                if (detail != null)
+                  Text(
+                    detail!,
+                    style: AppTextStyles.bodySmall.copyWith(
+                      fontSize: 12,
+                      color: AppColors.gray400,
+                    ),
+                  ),
+              ],
+            ),
+          ),
+          if (v != null && onChanged != null)
+            Switch(
+              value: v,
+              onChanged: onChanged,
+              activeTrackColor: AppColors.secondaryCyan,
+            )
+          else if (v != null)
+            Text(
+              v ? 'Oui' : 'Non',
+              style: AppTextStyles.label.copyWith(
+                color: v ? AppColors.secondaryCyan : AppColors.gray500,
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+}
+
+/// Les deux règles communes Fiesta (maquette `commonCard`).
+class FiestaCommonRulesCard extends StatelessWidget {
+  final bool oneAnswer;
+  final bool carryOver;
+
+  /// Nul = lecture seule (Récap).
+  final void Function({bool? oneAnswer, bool? carryOver})? onChanged;
+
+  const FiestaCommonRulesCard({
+    required this.oneAnswer,
+    required this.carryOver,
+    this.onChanged,
+    super.key,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final edit = onChanged;
+    return FiestaCard(
+      title: 'Règles communes Fiesta',
+      children: [
+        FiestaLine(
+          label: 'Une seule réponse',
+          detail: 'Une proposition par mot. Mauvaise réponse → il faut passer '
+              '(pénalité de passe). Simple annonce, l\'app ne vérifie pas.',
+          value: oneAnswer,
+          onChanged: edit == null ? null : (v) => edit(oneAnswer: v),
+        ),
+        FiestaLine(
+          label: 'Temps reporté de fin de manche',
+          detail: 'Le temps restant à la fin d\'une manche est rendu à '
+              'l\'équipe au début de la suivante.',
+          value: carryOver,
+          onChanged: edit == null ? null : (v) => edit(carryOver: v),
+        ),
+      ],
+    );
+  }
+}
+
+/// Texte d'explication gris (maquette `.hint`).
+class FiestaHint extends StatelessWidget {
+  final String text;
+  const FiestaHint(this.text, {super.key});
+
+  @override
+  Widget build(BuildContext context) => Text(
+        text,
+        style: AppTextStyles.bodySmall
+            .copyWith(fontSize: 12, color: AppColors.gray400),
+      );
+}
+
+/// Résumé d'une ligne du rattrapage, pour le Récap (Auto et Personnalisé).
+String catchUpSummary(CatchUpRules c) =>
+    '+${c.b1} s / +${c.b2} s × écart (max +${c.cap} s) · '
+    'leader −${c.mal} s × écart (max −${c.malCap} s)';
diff --git a/test/providers/fiesta_replay_test.dart b/test/providers/fiesta_replay_test.dart
new file mode 100644
index 0000000..c4165b0
--- /dev/null
+++ b/test/providers/fiesta_replay_test.dart
@@ -0,0 +1,79 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:guess_it_all_mobile/models/fiesta/fiesta_rules.dart';
+import 'package:guess_it_all_mobile/providers/game_provider.dart';
+import 'package:guess_it_all_mobile/utils/constants.dart';
+
+import '../helpers/test_prefs.dart';
+
+/// Un provider prêt à lancer une partie : 2 joueurs, 2 équipes, 1 mot chacun.
+Future<GameProvider> givenReadyProvider() async {
+  await givenPrefs();
+  givenFakePlatformPlugins();
+  final provider = GameProvider();
+  await pumpEventQueue();
+  for (final name in ['Ana', 'Bob']) {
+    provider.addPlayer(name);
+  }
+  givenWords(provider);
+  provider.createTeams();
+  provider.randomizeTeams();
+  return provider;
+}
+
+/// « Rejouer » efface les mots : on les ressaisit avant chaque lancement.
+void givenWords(GameProvider provider) {
+  for (final player in provider.players) {
+    provider.updatePlayerWords(player.id, ['mot-${player.name}']);
+  }
+}
+
+void main() {
+  test(
+      '« Rejouer » remet la config Fiesta gelée en attente et passe par le '
+      'Récap ; après une partie Classique, rien en attente', () async {
+    final provider = await givenReadyProvider();
+    provider.setPendingFiesta(
+      FiestaRules(mode: FiestaMode.auto, symmetric: false),
+    );
+    await provider.startGame(fiesta: provider.pendingFiesta);
+
+    await provider.restartWithSamePlayers();
+
+    expect(provider.game.currentScreen, AppConstants.screenFiestaRecap);
+    expect(provider.pendingFiesta!.mode, FiestaMode.auto);
+    expect(provider.pendingFiesta!.symmetric, isFalse);
+
+    // Même chose via l'accueil : fin de partie, puis « Rejouer » de l'accueil.
+    givenWords(provider);
+    await provider.startGame(fiesta: provider.pendingFiesta);
+    await provider.endGameAndGoHome();
+    await provider.restartWithSamePlayers();
+
+    expect(provider.game.currentScreen, AppConstants.screenFiestaRecap);
+    expect(provider.pendingFiesta!.symmetric, isFalse);
+
+    // App tuée en pleine partie Fiesta : la relance remet la config en attente,
+    // sinon « Retour aux équipes » puis « Lancer » repartirait en Classique.
+    givenWords(provider);
+    await provider.startGame(fiesta: provider.pendingFiesta);
+    await pumpEventQueue();
+    final reloaded = GameProvider();
+    await pumpEventQueue();
+    expect(reloaded.isFiesta, isTrue);
+    expect(reloaded.pendingFiesta?.symmetric, isFalse);
+
+    // « Nouvelle partie » repart d'un choix vide.
+    await reloaded.startNewGame();
+    expect(reloaded.pendingFiesta, isNull);
+
+    // Partie Classique lancée alors qu'une config traîne en attente : Rejouer
+    // suit la partie jouée, pas l'attente.
+    givenWords(provider);
+    await provider.startGame();
+
+    await provider.restartWithSamePlayers();
+
+    expect(provider.game.currentScreen, AppConstants.screenSettings);
+    expect(provider.pendingFiesta, isNull);
+  });
+}
