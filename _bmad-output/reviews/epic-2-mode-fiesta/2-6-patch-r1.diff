diff --git a/lib/widgets/fiesta/turn_time_cards.dart b/lib/widgets/fiesta/turn_time_cards.dart
new file mode 100644
index 0000000..16cb9e9
--- /dev/null
+++ b/lib/widgets/fiesta/turn_time_cards.dart
@@ -0,0 +1,113 @@
+import 'package:flutter/material.dart';
+import '../../models/fiesta/fiesta_rules.dart';
+import '../../models/fiesta/turn_time.dart';
+import '../../models/team.dart';
+import '../../theme/app_theme.dart';
+import 'fiesta_setup_widgets.dart';
+
+String _signed(int seconds) => '${seconds < 0 ? '−' : '+'}${seconds.abs()} s';
+
+/// « Temps du tour » (maquette `cd` / `cd2`) : une ligne par composante, le
+/// total. Avant le tour, sous les annonces Fiesta.
+class TurnTimeCard extends StatelessWidget {
+  final TurnTime time;
+
+  const TurnTimeCard(this.time, {super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final floored = time.total > time.lines.fold(0, (s, l) => s + l.seconds);
+    return FiestaCard(
+      title: 'Temps du tour',
+      trailing: Text(
+        '${time.total} s',
+        style: const TextStyle(
+            fontFamily: 'Bangers', fontSize: 24, color: AppColors.warning),
+      ),
+      children: [
+        for (final line in time.lines)
+          Padding(
+            padding: const EdgeInsets.only(bottom: 4),
+            child: Row(
+              mainAxisAlignment: MainAxisAlignment.spaceBetween,
+              children: [
+                Text(line.label, style: AppTextStyles.bodySmall),
+                Text(
+                  line == time.lines.first
+                      ? '${line.seconds} s'
+                      : _signed(line.seconds),
+                  style: AppTextStyles.bodySmall.copyWith(
+                    color: line.seconds < 0
+                        ? AppColors.error
+                        : line == time.lines.first
+                            ? AppColors.gray400
+                            : AppColors.success,
+                  ),
+                ),
+              ],
+            ),
+          ),
+        if (floored)
+          const FiestaHint('Plancher : un tour ne descend pas sous 10 s.'),
+      ],
+    );
+  }
+}
+
+/// « Rattrapage » (maquette `r2`) sur la transition : ce que chaque équipe
+/// aura en plus ou en moins à son premier tour de la manche suivante.
+class CatchUpCard extends StatelessWidget {
+  final List<CatchUpEntry> entries;
+  final CatchUpRules rules;
+  final List<Team> teams;
+
+  const CatchUpCard({
+    required this.entries,
+    required this.rules,
+    required this.teams,
+    super.key,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    if (entries.isEmpty) return const SizedBox.shrink();
+    return FiestaCard(
+      title: 'Rattrapage',
+      children: [
+        const FiestaHint('Appliqué au premier tour de chaque équipe dans la '
+            'manche (pas à une continuation).'),
+        const SizedBox(height: 6),
+        for (final e in entries)
+          Builder(builder: (context) {
+            final index = teams.indexWhere((t) => t.id == e.teamId);
+            final color = AppColors.getTeamColor(index < 0 ? 0 : index);
+            final name = index < 0 ? e.teamId : teams[index].name;
+            return Padding(
+              padding: const EdgeInsets.only(bottom: 4),
+              child: Row(
+                mainAxisAlignment: MainAxisAlignment.spaceBetween,
+                children: [
+                  Expanded(
+                    child: Text(
+                      '$name (${e.isLeader ? 'en tête' : 'menée'}) · '
+                      '${e.perPoint} s × ${e.gap}',
+                      style: AppTextStyles.bodySmall.copyWith(color: color),
+                    ),
+                  ),
+                  Text(
+                    _signed(e.seconds),
+                    style: AppTextStyles.bodySmall.copyWith(
+                      color: e.isLeader ? AppColors.error : AppColors.success,
+                      fontWeight: FontWeight.w600,
+                    ),
+                  ),
+                ],
+              ),
+            );
+          }),
+        FiestaHint('Plafonds : +${rules.cap} s pour les menées, '
+            '−${rules.malCap} s pour le leader.'),
+      ],
+    );
+  }
+}
diff --git a/test/models/fiesta/turn_time_test.dart b/test/models/fiesta/turn_time_test.dart
new file mode 100644
index 0000000..e88d02c
--- /dev/null
+++ b/test/models/fiesta/turn_time_test.dart
@@ -0,0 +1,106 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:guess_it_all_mobile/models/fiesta/fiesta_rules.dart';
+import 'package:guess_it_all_mobile/models/fiesta/turn_time.dart';
+
+Map<String, int> due(List<CatchUpEntry> entries) =>
+    {for (final e in entries) e.teamId: e.seconds};
+
+void main() {
+  group('Rattrapage — formule et plafonds', () {
+    test('Auto, 14–8 après M1 : +3 s × 6 à la menée, −1 s × 6 au leader', () {
+      final entries = computeCatchUp(
+        rules: CatchUpRules.auto,
+        round: 1,
+        scores: {'rose': 14, 'bleue': 8},
+      );
+      expect(due(entries), {'rose': -6, 'bleue': 18});
+      final leader = entries.singleWhere((e) => e.isLeader);
+      expect((leader.gap, leader.perPoint), (6, 1));
+
+      // AC2 : 30 + 18 = 48 s pour la menée, 30 − 6 = 24 s pour le leader.
+      expect(composeTurnSeconds(baseSeconds: 30, catchUpSeconds: 18).total, 48);
+      expect(
+          composeTurnSeconds(baseSeconds: 30, leaderMalusSeconds: 6).total, 24);
+    });
+
+    test('après M2, k = 5 et le bonus plafonne à 30 ; le malus à 15', () {
+      final entries = computeCatchUp(
+        rules: CatchUpRules.auto,
+        round: 2,
+        scores: {'rose': 20, 'bleue': 8, 'verte': 2},
+      );
+      // Écart 12 → 5 × 12 = 60, plafonné ; écart 18 → plafonné aussi.
+      // Leader : écart avec la 2ᵉ (12) → 1 × 12 = 12 (sous le plafond).
+      expect(due(entries), {'rose': -12, 'bleue': 30, 'verte': 30});
+
+      final capped = computeCatchUp(
+        rules: CatchUpRules.auto,
+        round: 2,
+        scores: {'rose': 30, 'bleue': 0},
+      );
+      expect(due(capped), {'rose': -15, 'bleue': 30});
+    });
+
+    test(
+        'égalité générale : rien ; co-leaders : tous en tête, malus sur la '
+        'meilleure non-leader', () {
+      expect(
+          computeCatchUp(
+            rules: CatchUpRules.auto,
+            round: 1,
+            scores: {'a': 7, 'b': 7, 'c': 7},
+          ),
+          isEmpty);
+
+      final entries = computeCatchUp(
+        rules: CatchUpRules.auto,
+        round: 1,
+        scores: {'a': 10, 'b': 10, 'c': 4},
+      );
+      expect(due(entries), {'a': -6, 'b': -6, 'c': 18});
+    });
+
+    test('Personnalisé tout à 0 = éteint ; Auto sans auto-calibrage = éteint',
+        () {
+      const off = CatchUpRules(b1: 0, b2: 0, cap: 0, mal: 0, malCap: 0);
+      expect(computeCatchUp(rules: off, round: 1, scores: {'a': 9, 'b': 1}),
+          isEmpty);
+      expect(
+          effectiveCatchUp(
+              FiestaRules(mode: FiestaMode.auto, autoCalibrate: false)),
+          isNull);
+      expect(
+          effectiveCatchUp(FiestaRules(mode: FiestaMode.custom, catchUp: off)),
+          same(off));
+    });
+  });
+
+  group('Durée du tour — composition', () {
+    test('plancher de 10 s après tous les malus (AC6)', () {
+      final time = composeTurnSeconds(
+        baseSeconds: 20,
+        leaderMalusSeconds: 15,
+        minus10sCount: 1,
+      );
+      expect(time.total, 10);
+      expect(time.lines.map((l) => l.seconds), [20, -15, -10]);
+    });
+
+    test(
+        'une continuation garde exactement ses secondes, sans modificateur '
+        '(Q5)', () {
+      final time = composeTurnSeconds(
+        baseSeconds: 30,
+        carriedSeconds: 7,
+        catchUpSeconds: 18,
+        leaderMalusSeconds: 6,
+        minus10sCount: 2,
+      );
+      expect(time.total, 7);
+      expect(time.lines.map((l) => l.seconds), [7]);
+
+      // Et sous le plancher aussi : 3 s reportées restent 3 s.
+      expect(composeTurnSeconds(baseSeconds: 30, carriedSeconds: 3).total, 3);
+    });
+  });
+}
